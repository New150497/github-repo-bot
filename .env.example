# ========================================================
# AI Gateway & Engine Configuration
# ========================================================
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=your_api_key_here
OMNIROUTE_MODEL=default-model

# ========================================================
# Optional: Repository Access Token (for private repos)
# ========================================================
# GITHUB_TOKEN=your_access_token_here

# ========================================================
# Workspace Directory (Defaults to ./repo)
# ========================================================
# REPO_WORKSPACE=./repo

# ========================================================
# Telegram Remote Controller (Free)
# ========================================================
# Get your free token in 1 min from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Optional: Auto-binds to your user ID on first /start
TELEGRAM_ALLOWED_USER_ID=



